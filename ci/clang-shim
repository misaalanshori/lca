#!/usr/bin/env bash
# ring's build script forces plain gcc-mode clang for Windows AArch64
# (its own FIXME in configure_cc), while cargo-xwin supplies MSVC-style
# flags. This shim sits ahead of the real clang and translates for the
# gcc-style driver: /imsvc <dir> becomes -I<dir>, --target=X becomes
# -target X, and the CL-only flags drop (-fuse-ld=lld-link is cargo's
# job at link time; ring only compiles objects). Everything else passes
# through untouched, including --version, so compiler-family detection
# still sees a real clang.
args=()
for ((i = 1; i <= $#; i++)); do
  a="${!i}"
  case "$a" in
    /imsvc)
      i=$((i + 1))
      args+=("-I${!i}")
      ;;
    --target=*)
      args+=("-target" "${a#--target=}")
      ;;
    -fuse-ld=lld-link)
      ;;
    -Xclang)
      i=$((i + 1))
      ;;
    *)
      args+=("$a")
      ;;
  esac
done
# Resolve the compiler, in preference order (gh #580). The release lanes
# install clang-19 from the distro archive and it is the version the MSVC
# build needs: 19.1.7's clang-cl agrees with xwin's intrin.h over
# __prefetch, 19.1.1's does not (wasmtime-fiber's windows.c). llvm-19 comes
# first. The clang-18 probe stays for an image that ships it without
# /usr/lib/llvm-19, and /usr/bin/clang is the last resort rather than the
# default: on a newer image it is clang-22, which is not what the release
# artifacts were built with, so silently using it reintroduces the mismatch.
real=/usr/bin/clang
for candidate in /usr/lib/llvm-19/bin/clang /usr/bin/clang-19 /usr/bin/clang-18; do
    if [ -x "$candidate" ]; then
        real="$candidate"
        break
    fi
done
exec "$real" "${args[@]}"
