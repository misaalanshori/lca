package lca:ext@0.2.0;

/// Types shared by every world. Every record that crosses the ABI carries
/// a reserved `extras` map so non-structural data can travel without a
/// version bump (docs/abi-versioning.md).
interface types {
  /// One key-value pair reserved for non-structural additions; WIT has no
  /// map type, so every `extras` field is a list of these.
  record extra-pair {
    key: string,
    value: string,
  }

  /// A tool call the model requested, as handed to the `tool` world.
  record tool-call {
    /// Provider-side call identifier; results reference it.
    call-id: string,
    /// Tool name.
    name: string,
    /// Argument string (JSON object text), accumulated host-side.
    arguments: string,
    /// Reserved map.
    extras: list<extra-pair>,
  }

  /// The outcome of one tool call.
  record tool-result {
    /// Call this answers.
    call-id: string,
    /// `ok`, `error`, `denied`, or `timeout` (docs/headless.md vocabulary).
    status: string,
    /// Text handed to the model, when there is no attachment.
    content: option<string>,
    /// Whether the content was truncated by the configured size limit.
    truncated: bool,
    /// Reserved map.
    extras: list<extra-pair>,
  }

  /// One block of message content. Text is the common case; an image is a
  /// typed block so a provider that carries vision can send the bytes
  /// without a side channel (ADR-0029, the ABI 0.2 window change).
  variant content-block {
    /// Plain text.
    text(string),
    /// An image: media type plus raw bytes.
    image(tuple<string, list<u8>>),
  }

  /// A message crossing into an extension (compaction, context-transform,
  /// provider).
  record message {
    /// `system`, `user`, `assistant`, or `tool`.
    role: string,
    /// Content blocks in order.
    content: list<content-block>,
    /// Tool calls this message carries, for assistant messages.
    tool-calls: list<tool-call>,
    /// `tool_call_id` this message answers, for tool messages.
    tool-call-id: option<string>,
    /// Reserved map.
    extras: list<extra-pair>,
  }

  /// Token usage and cost for one completion (`usage` stream event,
  /// `compaction` records, `completion` capability responses).
  record usage {
    /// Billed input tokens not served from cache.
    input: u64,
    /// Output tokens.
    output: u64,
    /// Input tokens served from the prompt cache.
    cache-read: u64,
    /// Input tokens written to the prompt cache this call.
    cache-write: u64,
    /// Input tokens written to the extended (one-hour) cache tier.
    cache-write-hour: u64,
    /// Cost in USD as reported or computed by the provider extension.
    cost: f64,
    /// Reserved map.
    extras: list<extra-pair>,
  }

  /// The widget vocabulary (ADR-0003): the host lays out and draws;
  /// text carries data, never control codes (FR-UI-2). A color field is
  /// a semantic role - intent, not color - so it renders under any theme
  /// and degrades to plain text without color (FR-UI-5).
  variant widget {
    /// Content plus its semantic role (`default`, `muted`, `warning`,
    /// `error`, `accent`, ... a string vocabulary, not an enum).
    text(tuple<string, string>),
    /// An image: media type plus bytes (ADR-0003's pre-freeze addition
    /// for provider image output).
    image(tuple<string, list<u8>>),
    /// A bordered box with an optional title around one child.
    /// A child reference is an index into the same node list: WIT
    /// records cannot be recursive, so trees travel as an arena with
    /// node0 as the root (documented at the `render` interface).
    boxed(tuple<option<string>, u32>),
    /// Children side by side, as node indices.
    row(list<u32>),
    /// Children stacked, as node indices.
    column(list<u32>),
    /// A busy indicator; the animation frames are the host's.
    spinner(string),
    /// A label with a0..1 fill fraction.
    progress(tuple<string, f32>),
    /// Label/value pairs (the key-value list).
    keyvalue(list<tuple<string, string>>),
    /// Reserved so the vocabulary's next kind lands without a canonical
    /// ABI break (ADR-0003; never constructed by1.0 hosts).
    vendor(string),
  }

  record session-record {
    /// The log's `t` tag: user, assistant, tool-call, tool-result, ...
    kind: string,
    /// Record identifier, sortable by creation order.
    id: string,
    /// JSON-serialized record body, shaped by `kind`.
    body: string,
    /// Reserved map.
    extras: list<extra-pair>,
  }
}
