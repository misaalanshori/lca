package lca:ext@0.1.0;

/// The `tool` world: register one callable tool with the model.
world tool {
  import lca:host/log@0.1.0;
  // Capability interfaces for tool-world components. The host provides
  // every interface in a denied state and raises it to the granted state
  // from the manifest, so an undeclared capability call returns a
  // permission error and is recorded (FR-PERM-3) rather than vanishing.
  import lca:host/fs@0.1.0;
  import lca:host/process@0.1.0;
  import lca:host/pty@0.1.0;
  export tool-schema;
  export execute;
}

interface tool-schema {
  use types.{extra-pair};

  /// What the model sees when choosing a tool.
  record schema {
    name: string,
    description: string,
    /// JSON Schema for the arguments, as JSON text.
    parameters: string,
    extras: list<extra-pair>,
  }

  /// The tool this extension registers. Names form one namespace with the
  /// built-ins; a collision disables the later registration (FR-EXT-11).
  get-schema: func() -> schema;
}

interface execute {
  use types.{tool-call, tool-result};

  /// Run one call. The host validates arguments against the schema first.
  run: func(call: tool-call) -> tool-result;
}
