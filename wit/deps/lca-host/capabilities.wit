package lca:host@0.2.0;

/// The `fs` capability: named scopes, never paths in the manifest
/// (ADR-0005). Every refusal is one of these cases so the host can record
/// attempts distinctly (capability catalog).
interface fs {
  variant error {
    /// The operation left the scope, entered the state directory, or the
    /// grant's mode refuses it (FR-PERM-12).
    permission(string),
    /// The scope is not in this extension's granted set (NFR-13).
    not-granted(string),
    not-found(string),
    io(string),
    invalid(string),
  }

  record file-info {
    is-dir: bool,
    len: u64,
  }

  read: func(scope: string, path: string) -> result<list<u8>, error>;
  write: func(scope: string, path: string, bytes: list<u8>) -> result<_, error>;
  // The catalog's "list" function: `list` is a WIT keyword, so the
  // exported name is list-entries.
  list-entries: func(scope: string, path: string) -> result<list<string>, error>;
  stat: func(scope: string, path: string) -> result<file-info, error>;
}

/// The `process` capability: ask the host to run a program (argv, no
/// shell) in a directory the extension can already see. Every command
/// still passes the user's approval prompt (capability catalog).
interface process {
  variant error {
    permission(string),
    /// The capability is not in this extension's granted set (NFR-13).
    not-granted(string),
    not-found(string),
    io(string),
    invalid(string),
  }

  /// Spawn with pipes for stdin, stdout, and stderr; the numeric handle
  /// names those three streams in the host's table until closed.
  spawn: func(program: string, args: list<string>, cwd-scope: string)
    -> result<u32, error>;
  read-stdout: func(handle: u32, max: u64) -> result<option<list<u8>>, error>;
  read-stderr: func(handle: u32, max: u64) -> result<option<list<u8>>, error>;
  write-stdin: func(handle: u32, bytes: list<u8>) -> result<u64, error>;
  /// Block until the child exits; returns its exit code (128+signal when
  /// signalled).
  wait: func(handle: u32) -> result<s32, error>;
  /// Kill the whole process tree and release the handle.
  kill: func(handle: u32) -> result<_, error>;
}

/// The `pty` capability (ADR-0016): allocate a pseudo-terminal host-side
/// so an interactively spawned program sees a real terminal; output and
/// keystrokes flow through the host, never raw terminal bytes from the
/// extension.
interface pty {
  variant error {
    permission(string),
    /// The capability is not in this extension's granted set (NFR-13).
    not-granted(string),
    not-found(string),
    io(string),
    invalid(string),
  }

  spawn: func(
    program: string,
    args: list<string>,
    cwd-scope: string,
    rows: u16,
    cols: u16,
  ) -> result<u32, error>;
  read: func(handle: u32, max: u64) -> result<option<list<u8>>, error>;
  write: func(handle: u32, bytes: list<u8>) -> result<u64, error>;
  resize: func(handle: u32, rows: u16, cols: u16) -> result<_, error>;
  wait: func(handle: u32) -> result<s32, error>;
  kill: func(handle: u32) -> result<_, error>;
}

/// The `net` capability: outbound requests through the host, never a
/// socket (capability catalog). One interface serves both `net`
/// (internet hosts, HTTPS only) and `net-local` (local ranges, HTTP
/// allowed); dispatch between them is stated once in the catalog and
/// enforced by the granted pattern sets.
interface net {
  variant error {
    /// Pattern mismatch, rebinding refusal (FR-PERM-13), or scheme/port
    /// rules; the detail says which, and the host records it.
    permission(string),
    /// The capability is not in this extension's granted set (NFR-13).
    not-granted(string),
    dns(string),
    /// TLS or certificate failure.
    tls(string),
    io(string),
    invalid(string),
  }

  /// Start a request; returns a response handle. `net` grants accept
  /// only `https`, `net-local` grants accept `http` too (ADR-0011).
  request: func(
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
  ) -> result<u32, error>;
  response-status: func(handle: u32) -> result<u16, error>;
  response-headers: func(handle: u32) -> result<list<tuple<string, string>>, error>;
  /// Read the body until it ends; `None` means EOF.
  read-body: func(handle: u32, max: u64) -> result<option<list<u8>>, error>;
  close-response: func(handle: u32) -> result<_, error>;
}

/// The `oauth` capability: the loopback authorization flow. The extension
/// never binds a port; the host listener binds127.0.0.1 only
/// (FR-PROV-4).
interface oauth {
  variant error {
    permission(string),
    not-granted(string),
    /// No callback arrived before the flow timeout (default300 s).
    timeout(string),
    io(string),
    invalid(string),
  }

  /// Pick a port, bind the loopback listener, and return the redirect
  /// URL plus a flow handle (FR-PROV-3).
  begin: func(redirect-path: string) -> result<tuple<string, u32>, error>;
  /// Open a URL in the user's browser (best effort).
  open: func(url: string) -> result<_, error>;
  /// Block until the callback arrives; returns its parsed query
  /// parameters. The extension verifies `state` itself.
  await-callback: func(handle: u32) -> result<list<tuple<string, string>>, error>;
  /// Abandon a flow and stop its listener.
  end-flow: func(handle: u32) -> result<_, error>;
}

/// The `credentials` capability: one namespace per extension, keyed by
/// the extension's own identity (FR-PERM-6). There is no cross-namespace
/// read at any privilege level (FR-PERM-7); a denied `get` returns an
/// empty result rather than an error, so checking for an existing login
/// needs no denial/absence distinction (capability catalog).
interface credentials {
  variant error {
    permission(string),
    not-granted(string),
    io(string),
    invalid(string),
  }

  get: func(key: string) -> option<string>;
  set: func(key: string, value: string) -> result<_, error>;
  delete: func(key: string) -> result<_, error>;
}

/// The `resources` bag (ADR-0030): the extension's own read-only package
/// data. Always available, like `log` - this is a package-scoped read, not
/// an `fs` grant, and it works whether or not the extension holds `fs`.
/// The path resolves inside the calling extension's own `resources/` tree
/// only: no traversal, no absolute path, no NUL, no cross-extension reach.
/// Both delivery modes serve it from the same seam (ADR-0032).
interface resources {
  variant error {
    /// The path left the extension's resource tree, or is absolute/NUL.
    permission(string),
    not-found(string),
    /// Malformed input, or the read exceeds the per-call size cap.
    invalid(string),
  }

  record resource-entry {
    path: string,
    size: u64,
  }

  /// List entries under `prefix` (empty lists everything), relative to the
  /// extension's resource root.
  list-resources: func(prefix: string) -> result<list<resource-entry>, error>;
  /// Read one resource's full bytes.
  read: func(path: string) -> result<list<u8>, error>;
}
